@startuml

top to bottom direction

actor "Пользователь" as User

rectangle "Веб-интерфейс\n(сайт)" as Web
rectangle "Сервер" as Server
database "База данных" as DB
rectangle "Уведомления" as Notifications
cloud "Email" as Email

User --> Web : Открывает сайт
Web --> Server : Запросы
Server --> DB : Хранение данных
Server --> Notifications : Отправить уведомление
Notifications --> Email : Письмо владельцу

@enduml
