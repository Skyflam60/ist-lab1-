@startuml

left to right direction

actor "Владелец\nживотного" as Owner
actor "Администратор" as Admin
actor "Ветеринарный\nврач" as Doctor
actor "Руководитель" as Manager

rectangle "Система управления ветеринарной клиникой" {
  usecase "Зарегистрировать\nвладельца и животное" as UC1
  usecase "Записать\nна приём" as UC2
  usecase "Просмотреть\nрасписание" as UC3
  usecase "Провести\nприём" as UC4
  usecase "Создать медицинскую\nзапись" as UC5
  usecase "Просмотреть историю\nлечения" as UC6
  usecase "Просмотреть\nотчёты" as UC7
}

Admin --> UC1
Admin --> UC2

Doctor --> UC3
Doctor --> UC4
Doctor --> UC5
Doctor --> UC6

Owner --> UC6

Manager --> UC7

UC4 .> UC5 : <<include>>

@endumlDoctor --> UCMySchedule
Doctor --> UCConductVisit
Doctor --> UCCreateRecord
Doctor --> UCPrescribeTreatment
Doctor --> UCDoctorHistory

Manager --> UCAuth
Manager --> UCGenerateReport
Manager --> UCStatistics

SysAdmin --> UCAuth
SysAdmin --> UCManageUsers
SysAdmin --> UCManageDirectories

UCRegisterPet .> UCRegisterOwner : <<include>>
UCBookVisit .> UCViewSchedule : <<include>>
UCConductVisit .> UCCreateRecord : <<include>>
UCCreateRecord .> UCPrescribeTreatment : <<include>>
UCHistory .> UCViewPet : <<include>>
UCDoctorHistory .> UCConductVisit : <<extend>>
UCStatistics .> UCGenerateReport : <<include>>

@enduml
